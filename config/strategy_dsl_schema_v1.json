{
  "$id": "strategy_dsl_schema_v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Machine contract for deterministic Korean-equity Strategy DSL generation.",
  "properties": {
    "asset_class": {
      "enum": [
        "kr_equity"
      ]
    },
    "benchmark": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "index"
          ]
        },
        "symbol": {
          "enum": [
            "KOSDAQ",
            "KOSDAQ150",
            "KOSPI",
            "KOSPI200"
          ]
        }
      },
      "required": [
        "source",
        "symbol"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "cost_scenarios": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "commission_bps": {
            "default": 0.0,
            "minimum": 0,
            "type": "number"
          },
          "market_impact_bps": {
            "default": 0.0,
            "minimum": 0,
            "type": "number"
          },
          "sell_tax_bps": {
            "default": 0.0,
            "minimum": 0,
            "type": "number"
          },
          "slippage_bps": {
            "default": 0.0,
            "minimum": 0,
            "type": "number"
          },
          "spread_bps": {
            "default": 0.0,
            "minimum": 0,
            "type": "number"
          }
        },
        "type": "object"
      },
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "type": "object"
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "lag_sessions": {
          "minimum": 1,
          "type": "integer"
        },
        "price": {
          "enum": [
            "next_close"
          ]
        }
      },
      "required": [
        "lag_sessions",
        "price"
      ],
      "type": "object"
    },
    "factors": {
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "oneOf": [
              {
                "properties": {
                  "field": {
                    "enum": [
                      "book_to_price",
                      "cashflow_yield",
                      "earnings_yield",
                      "quarterly_net_margin",
                      "quarterly_ocf_margin",
                      "quarterly_roe",
                      "sales_yield"
                    ]
                  },
                  "source": {
                    "const": "dart"
                  }
                },
                "required": [
                  "source",
                  "field"
                ]
              },
              {
                "properties": {
                  "field": {
                    "enum": [
                      "Amount",
                      "Change",
                      "ChangesRatio",
                      "Close",
                      "High",
                      "Low",
                      "Marcap",
                      "Open",
                      "Stocks",
                      "Volume"
                    ]
                  },
                  "source": {
                    "const": "krx"
                  }
                },
                "required": [
                  "source",
                  "field"
                ]
              },
              {
                "properties": {
                  "field": {
                    "enum": [
                      "momentum_12_0",
                      "momentum_12_1",
                      "momentum_3_1",
                      "momentum_6_1",
                      "volatility_12m",
                      "volatility_3m",
                      "volatility_6m"
                    ]
                  },
                  "source": {
                    "const": "technical"
                  }
                },
                "required": [
                  "source",
                  "field"
                ]
              }
            ]
          }
        ],
        "properties": {
          "direction": {
            "enum": [
              "high",
              "low"
            ]
          },
          "field": {
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "transform": {
            "default": "identity",
            "enum": [
              "identity",
              "inverse",
              "log1p"
            ]
          },
          "weight": {
            "default": 1.0,
            "exclusiveMinimum": 0,
            "type": "number"
          }
        },
        "required": [
          "name",
          "source",
          "field",
          "direction"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "initial_capital": {
      "default": 10000000,
      "exclusiveMinimum": 0,
      "type": "number"
    },
    "metadata": {
      "additionalProperties": true,
      "type": "object"
    },
    "period": {
      "additionalProperties": false,
      "properties": {
        "as_of_date": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": [
            "string",
            "null"
          ]
        },
        "book_end": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "book_start": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "end": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        },
        "start": {
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "book_start",
        "book_end"
      ],
      "type": "object"
    },
    "portfolio": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "number_of_positions": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "number_of_positions"
            ]
          },
          "if": {
            "properties": {
              "selection": {
                "const": "deciles"
              }
            },
            "required": [
              "selection"
            ]
          },
          "then": {
            "properties": {
              "number_of_positions": {
                "const": null
              }
            }
          }
        }
      ],
      "properties": {
        "number_of_positions": {
          "minimum": 1,
          "type": [
            "integer",
            "null"
          ]
        },
        "selection": {
          "default": "top_n",
          "enum": [
            "deciles",
            "top_n"
          ]
        },
        "weighting": {
          "enum": [
            "equal"
          ]
        }
      },
      "required": [
        "weighting"
      ],
      "type": "object"
    },
    "rebalance": {
      "additionalProperties": false,
      "properties": {
        "dart_period_policy": {
          "default": "legacy_april_october",
          "enum": [
            "legacy_april_october",
            "latest_disclosed_quarter"
          ]
        },
        "frequency": {
          "enum": [
            "months"
          ]
        },
        "months": {
          "items": {
            "maximum": 12,
            "minimum": 1,
            "type": "integer"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "trading_day": {
          "enum": [
            "last"
          ]
        }
      },
      "required": [
        "frequency",
        "months",
        "trading_day"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0"
    },
    "strategy_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "universe": {
      "additionalProperties": false,
      "properties": {
        "filters": {
          "default": [],
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "else": {
                  "required": [
                    "value"
                  ]
                },
                "if": {
                  "properties": {
                    "op": {
                      "const": "notnull"
                    }
                  },
                  "required": [
                    "op"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "null"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "op": {
                      "enum": [
                        "gt",
                        "gte",
                        "lt",
                        "lte"
                      ]
                    }
                  },
                  "required": [
                    "op"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "number"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "op": {
                      "enum": [
                        "top_pct",
                        "bottom_pct",
                        "exclude_top_pct",
                        "exclude_bottom_pct"
                      ]
                    }
                  },
                  "required": [
                    "op"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "exclusiveMaximum": 100,
                      "exclusiveMinimum": 0,
                      "type": "number"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "op": {
                      "enum": [
                        "eq",
                        "ne"
                      ]
                    }
                  },
                  "required": [
                    "op"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "op": {
                      "enum": [
                        "in",
                        "not_in"
                      ]
                    }
                  },
                  "required": [
                    "op"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      "minItems": 1,
                      "type": "array"
                    }
                  }
                }
              }
            ],
            "properties": {
              "field": {
                "enum": [
                  "Amount",
                  "Change",
                  "ChangesRatio",
                  "Close",
                  "High",
                  "Low",
                  "Marcap",
                  "Open",
                  "Stocks",
                  "Volume",
                  "book_to_price",
                  "cashflow_yield",
                  "earnings_yield",
                  "momentum_12_0",
                  "momentum_12_1",
                  "momentum_3_1",
                  "momentum_6_1",
                  "quarterly_net_margin",
                  "quarterly_ocf_margin",
                  "quarterly_roe",
                  "sales_yield",
                  "volatility_12m",
                  "volatility_3m",
                  "volatility_6m"
                ]
              },
              "op": {
                "enum": [
                  "bottom_pct",
                  "eq",
                  "exclude_bottom_pct",
                  "exclude_top_pct",
                  "gt",
                  "gte",
                  "in",
                  "lt",
                  "lte",
                  "ne",
                  "not_in",
                  "notnull",
                  "top_pct"
                ]
              },
              "value": {}
            },
            "required": [
              "field",
              "op"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "markets": {
          "items": {
            "enum": [
              "KOSPI",
              "KOSDAQ"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "require_tradable_on_signal": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "markets"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "strategy_id",
    "title",
    "asset_class",
    "universe",
    "factors",
    "portfolio",
    "rebalance",
    "execution",
    "cost_scenarios",
    "period"
  ],
  "title": "quant-marcap-runner Strategy DSL",
  "type": "object",
  "x-input-validation": {
    "dates": "real calendar dates in YYYY-MM-DD; start <= end and book_start <= book_end",
    "duplicate_json_keys": "reject at every object, including metadata",
    "entry_points": [
      "load_strategy_spec",
      "StrategySpec.from_dict"
    ],
    "failure": "preflight capability_gap in compile phase before any data access or NAV",
    "numbers": "finite and representable as a finite float; including metadata",
    "runtime_semantics": [
      "strict integer tokens",
      "finite numbers and weight/cost totals",
      "ordered periods",
      "unique normalized factor names",
      "registry source constraints"
    ],
    "schema_builder": "scripts/strategy_dsl.py:build_strategy_json_schema",
    "types": "reject numeric strings, booleans as numbers and non-integer tokens in integer fields",
    "unknown_fields": "reject at every strategy object; metadata permits arbitrary JSON properties",
    "version": "1"
  }
}
