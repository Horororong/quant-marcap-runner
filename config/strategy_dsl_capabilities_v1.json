{
  "asset_classes": [
    "kr_equity"
  ],
  "canonical_outputs": [
    "daily_nav.csv",
    "target_weights.csv",
    "selections.csv",
    "execution_plan.json",
    "strategy_fingerprint.txt",
    "factor_provider_coverage.csv",
